/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\Fractal Generator.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\Toolbar.bmp"
IDR_FRACTAL             BITMAP                  "res\\toolbar1.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_APP_ABOUT
END

IDR_FRACTAL TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_SAVEAS
    SEPARATOR
    BUTTON      ID_FRACTAL_BEGIN
    BUTTON      ID_VIEW_FRACTALPARAMETERS
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        POPUP "Save"
        BEGIN
            MENUITEM "Save &Main As...\tCtrl+S",    ID_FILE_SAVEAS
            MENUITEM "Save &Secondary As...\tCtrl+Shift+S", ID_SAVE_SAVESECONDARYAS
        END
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "Fr&actal"
    BEGIN
        MENUITEM "&Render\tF5",                 ID_FRACTAL_BEGIN
        MENUITEM "&Time...",                    ID_FRACTAL_TIME
        MENUITEM SEPARATOR
        MENUITEM "Auto-Generate Julia Set\tCtrl+A", ID_FRACTAL_AUTOJULIA
        MENUITEM "Smooth Shading\tCtrl+M",      ID_FRACTAL_SMOOTHSHADING
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Julia Window",                ID_VIEW_JULIAWINDOW
        MENUITEM SEPARATOR
        MENUITEM "&Image Properties...",        ID_VIEW_IMAGEPROPERTIES
        MENUITEM "&Fractal Parameters...",      ID_VIEW_FRACTALPARAMETERS
        MENUITEM SEPARATOR
        MENUITEM "Palette Editor...",           ID_VIEW_PALETTEEDITOR
        MENUITEM SEPARATOR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Help...",                     ID_HELP_HELP
        MENUITEM "&About Fractal Generator...", ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT, NOINVERT
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
    "S",            ID_FILE_SAVEAS,         VIRTKEY, CONTROL, NOINVERT
    VK_F5,          ID_FRACTAL_BEGIN,       VIRTKEY, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    "R",            ID_VIEW_FRACTALPARAMETERS, VIRTKEY, CONTROL, NOINVERT
    "D",            ID_VIEW_IMAGEPROPERTIES, VIRTKEY, CONTROL, NOINVERT
    "A",            ID_FRACTAL_AUTOJULIA,   VIRTKEY, CONTROL, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Fractal Generator"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "Fractal Generator Version 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2006 Garrett Miller",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,16,WS_GROUP
END

IDD_FRACTAL_PARAMS DIALOGEX 0, 0, 168, 134
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_WINDOWEDGE
CAPTION "Fractal Parameters"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Apply",IDOK,111,113,50,14
    PUSHBUTTON      "Close",IDCANCEL,7,113,50,14
    GROUPBOX        "Viewport",IDC_STATIC,7,7,154,72
    LTEXT           "X   Minimum                          Maximum",IDC_STATIC,15,19,119,8
    EDITTEXT        IDC_XMIN,15,28,66,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_XMAX,86,28,66,14,ES_AUTOHSCROLL
    LTEXT           "Y   Minimum                          Maximum",IDC_STATIC,15,46,119,8
    EDITTEXT        IDC_YMIN,15,56,66,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_YMAX,86,56,66,14,ES_AUTOHSCROLL
    LTEXT           "Bailout",IDC_STATIC,34,81,22,8
    EDITTEXT        IDC_BAILOUT,15,92,66,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_MAXITERS,86,92,66,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Max Iterations",IDC_STATIC,96,81,48,8
END

IDD_HELPDIALOG DIALOGEX 0, 0, 315, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fractal Generator Help"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,133,125,50,14
    LTEXT           "How to draw the Mandelbrot fractal:",IDC_STATIC,10,11,118,8
    LTEXT           " - Click the Begin button on the toolbar",IDC_STATIC,19,21,124,8
    LTEXT           " - Go to Fractal -> Begin",IDC_STATIC,19,31,78,8
    LTEXT           "You can click on any part of the image to zoom in 50% and recenter around that point.",IDC_STATIC,7,48,278,8
    LTEXT           "If you hold down Ctrl while clicking, you can just recenter.",IDC_STATIC,7,79,186,8
    LTEXT           "If you hold down Shift while clicking, you double the amount of zoom.",IDC_STATIC,7,91,222,8
    LTEXT           "You can right-click on any part of the image to zoom out 50% and recenter around that point.",IDC_STATIC,7,60,301,8
END

IDD_JULIA_WINDOW DIALOGEX 300, 10, 187, 90
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_OVERLAPPEDWINDOW | WS_EX_TOOLWINDOW
CAPTION "Julia Fractal"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

IDD_IMAGE_PROPS DIALOGEX 0, 0, 276, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_PALETTEWINDOW
CAPTION "Image Properties"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Apply",IDOK,219,66,50,14,WS_DISABLED
    PUSHBUTTON      "Close",IDCANCEL,7,66,50,14
    LTEXT           "Width",IDC_STATIC,32,22,20,8
    EDITTEXT        IDC_MAIN_WIDTH,24,32,37,14,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_MAIN_HEIGHT,77,32,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Height",IDC_STATIC,87,22,22,8
    LTEXT           "x",IDC_STATIC,67,35,8,8
    GROUPBOX        "Main Window (Mandelbrot)",IDC_STATIC,7,7,127,58
    LTEXT           "Width",IDC_STATIC,167,22,20,8
    EDITTEXT        IDC_SECONDARY_WIDTH,159,32,37,14,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_SECONDARY_HEIGHT,212,32,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Height",IDC_STATIC,222,22,22,8
    LTEXT           "x",IDC_STATIC,202,35,8,8
    GROUPBOX        "Secondary Window (Julia)",IDC_STATIC,142,7,127,58
END

IDD_PALETTEDLG DIALOGEX 45, 300, 324, 199
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_WINDOWEDGE
CAPTION "Palette Editor"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Apply",IDOK,142,178,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,7,178,50,14
    CONTROL         "",IDC_REDSLIDER,"msctls_trackbar32",TBS_TOP | TBS_NOTICKS | WS_TABSTOP,17,58,180,13
    CONTROL         "",IDC_GREENSLIDER,"msctls_trackbar32",TBS_TOP | TBS_NOTICKS | WS_TABSTOP,17,86,180,13
    CONTROL         "",IDC_BLUESLIDER,"msctls_trackbar32",TBS_TOP | TBS_NOTICKS | WS_TABSTOP,17,114,180,13
    CONTROL         "",IDC_ENABLERED,"Button",BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP,0,54,16,8
    CONTROL         "",IDC_ENABLEGREEN,"Button",BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP,0,81,16,8
    CONTROL         "",IDC_ENABLEBLUE,"Button",BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP,0,111,16,8
    LTEXT           "y = a * sin(f * x) + b",IDC_STATIC,228,15,68,8
    EDITTEXT        IDC_AMP_RED,211,51,26,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_FREQ_RED,250,51,26,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_BASE_RED,289,51,26,14,ES_AUTOHSCROLL
    LTEXT           "A",IDC_STATIC,200,54,8,8
    LTEXT           "F",IDC_STATIC,242,53,8,8
    LTEXT           "B",IDC_STATIC,281,54,8,8
    EDITTEXT        IDC_AMP_GREEN,211,78,26,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_FREQ_GREEN,250,78,26,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_BASE_GREEN,289,78,26,14,ES_AUTOHSCROLL
    LTEXT           "A",IDC_STATIC,200,81,8,8
    LTEXT           "F",IDC_STATIC,242,80,8,8
    LTEXT           "B",IDC_STATIC,281,81,8,8
    EDITTEXT        IDC_AMP_BLUE,211,107,26,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_FREQ_BLUE,250,107,26,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_BASE_BLUE,289,107,26,14,ES_AUTOHSCROLL
