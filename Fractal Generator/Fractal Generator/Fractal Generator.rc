/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_APP_ABOUT
END

IDR_FRACTAL TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_SAVEAS
    SEPARATOR
    BUTTON      ID_FRACTAL_BEGIN
    BUTTON      ID_VIEW_FRACTALPARAMETERS
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        POPUP "New"
        BEGIN
            POPUP "Complex"
            BEGIN
                MENUITEM "Mandelbrot",                  ID_NEW_MANDELBROT
                MENUITEM "Julia",                       ID_NEW_JULIA
                MENUITEM "Newton",                      ID_NEW_NEWTON
                MENUITEM "Quaternion",                  ID_NEW_QUATERNION
                MENUITEM "Real-Time Shader",            ID_NEW_LSYSTEM_1
            END
            POPUP "MRCM"
            BEGIN
                MENUITEM "Sierpinsky Gasket",           ID_NEW_GASKET
                MENUITEM "Twin Christmas Tree",         ID_NEW_TWINXMASTREE
                MENUITEM "5 pt. Snowflake",             ID_NEW_5PTSNOWFLAKE
                MENUITEM "Fern",                        ID_NEW_FERN
                MENUITEM "Koch Curve",                  ID_NEW_KOCHCURVE
                MENUITEM SEPARATOR
                MENUITEM "Custom...\tCtrl+N",           ID_FILE_NEW
            END
            POPUP "L-System"
            BEGIN
                MENUITEM "1",                           ID_NEW_LSYSTEM_1
                MENUITEM "2",                           ID_NEW_LSYSTEM_2
                MENUITEM "3",                           ID_NEW_LSYSTEM_3
            END
            POPUP "Midpoint Displacement"
            BEGIN
                MENUITEM "Line",                        ID_NEW_MDPTDISP_1D
                MENUITEM "Plane",                       ID_NEW_MDPTDISP_2D
                MENUITEM "Volume",                      ID_NEW_MDPTDISP_3D
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Fractal Generator...", ID_APP_ABOUT
    END
END

IDR_FractalGeneratoTYPE MENU 
BEGIN
    POPUP "&File"
    BEGIN
        POPUP "New"
        BEGIN
            POPUP "Complex"
            BEGIN
                MENUITEM "Mandelbrot",                  ID_NEW_MANDELBROT
                MENUITEM "Julia",                       ID_NEW_JULIA
                MENUITEM "Newton",                      ID_NEW_NEWTON
                MENUITEM "Quaternion",                  ID_NEW_QUATERNION
                MENUITEM "Real-Time Shader",            ID_NEW_QUATERNION
            END
            POPUP "MRCM"
            BEGIN
                MENUITEM "Sierpinsky Gasket",           ID_NEW_GASKET
                MENUITEM "Twin Christmas Tree",         ID_NEW_TWINXMASTREE
                MENUITEM "5 pt. Snowflake",             ID_NEW_5PTSNOWFLAKE
                MENUITEM "Fern",                        ID_NEW_FERN
                MENUITEM "Koch Curve",                  ID_NEW_KOCHCURVE
                MENUITEM SEPARATOR
                MENUITEM "Custom...\tCtrl+N",           ID_FILE_NEW
            END
            POPUP "L-System"
            BEGIN
                MENUITEM "1",                           ID_NEW_LSYSTEM_1
                MENUITEM "2",                           ID_NEW_LSYSTEM_2
                MENUITEM "3",                           ID_NEW_LSYSTEM_3
            END
            POPUP "Midpoint Displacement"
            BEGIN
                MENUITEM "Line",                        ID_NEW_MDPTDISP_1D
                MENUITEM "Plane",                       ID_NEW_MDPTDISP_2D
                MENUITEM "Volume",                      ID_NEW_MDPTDISP_3D
            END
        END
        MENUITEM SEPARATOR
        POPUP "Save"
        BEGIN
            MENUITEM "Save &Main As...\tCtrl+S",    ID_FILE_SAVEAS
        END
        MENUITEM SEPARATOR
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "Fr&actal"
    BEGIN
        MENUITEM "&Render\tF5",                 ID_FRACTAL_BEGIN
        MENUITEM "&Time...",                    ID_FRACTAL_TIME
        MENUITEM SEPARATOR
        MENUITEM "Auto-Generate Julia Set\tCtrl+A", ID_FRACTAL_AUTOJULIA
        MENUITEM "Smooth Shading\tCtrl+M",      ID_FRACTAL_SMOOTHSHADING
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Julia Window",                ID_VIEW_JULIAWINDOW
        MENUITEM SEPARATOR
        MENUITEM "&Image Properties...",        ID_VIEW_IMAGEPROPERTIES
        MENUITEM "&Fractal Parameters...",      ID_VIEW_FRACTALPARAMETERS
        MENUITEM SEPARATOR
        MENUITEM "Palette Editor...",           ID_VIEW_PALETTEEDITOR
        MENUITEM SEPARATOR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Tile",                       ID_WINDOW_TILE_HORZ
        MENUITEM "&Arrange Icons",              ID_WINDOW_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Fractal Generator...", ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT, NOINVERT
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL, NOINVERT
    "S",            ID_FILE_SAVEAS,         VIRTKEY, CONTROL, NOINVERT
    "A",            ID_FRACTAL_AUTOJULIA,   VIRTKEY, CONTROL, NOINVERT
    VK_F5,          ID_FRACTAL_BEGIN,       VIRTKEY, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    "R",            ID_VIEW_FRACTALPARAMETERS, VIRTKEY, CONTROL, NOINVERT
    "D",            ID_VIEW_IMAGEPROPERTIES, VIRTKEY, CONTROL, NOINVERT
END


