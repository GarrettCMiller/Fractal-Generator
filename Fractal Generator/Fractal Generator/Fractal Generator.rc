    DEFPUSHBUTTON   "OK",IDOK,178,7,50,16,WS_GROUP
END

IDD_FRACTAL_PARAMS DIALOGEX 0, 0, 168, 211
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_WINDOWEDGE
CAPTION "Fractal Parameters"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Apply",IDAPPLY,111,190,50,14
    PUSHBUTTON      "Close",IDCANCEL,7,190,50,14
    GROUPBOX        "Viewport",IDC_STATIC,7,7,154,72
    LTEXT           "X   Minimum                          Maximum",IDC_STATIC,15,19,119,8,WS_DISABLED
    EDITTEXT        IDC_XMIN,15,28,66,14,ES_AUTOHSCROLL | WS_DISABLED
    EDITTEXT        IDC_XMAX,86,28,66,14,ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "Y   Minimum                          Maximum",IDC_STATIC,15,46,119,8,WS_DISABLED
    EDITTEXT        IDC_YMIN,15,56,66,14,ES_AUTOHSCROLL | WS_DISABLED
    EDITTEXT        IDC_YMAX,86,56,66,14,ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "Bailout",IDC_STATIC,34,81,22,8
    EDITTEXT        IDC_BAILOUT,15,92,66,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_MAXITERS,86,92,66,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Max Iterations",IDC_STATIC,96,81,48,8
    GROUPBOX        "Shader Params",IDC_STATIC,7,108,154,78
    EDITTEXT        IDC_SHADERPATH,10,119,137,14,ES_AUTOHSCROLL,WS_EX_ACCEPTFILES
    PUSHBUTTON      "...",IDC_BROWSE_SHADER,148,118,13,14
END

IDD_HELPDIALOG DIALOGEX 0, 0, 315, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fractal Generator Help"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,133,125,50,14
    LTEXT           "How to draw the Mandelbrot fractal:",IDC_STATIC,10,11,118,8
    LTEXT           " - Click the Begin button on the toolbar",IDC_STATIC,19,21,124,8
    LTEXT           " - Go to Fractal -> Begin",IDC_STATIC,19,31,78,8
    LTEXT           "You can click on any part of the image to zoom in 50% and recenter around that point.",IDC_STATIC,7,48,278,8
    LTEXT           "If you hold down Ctrl while clicking, you can just recenter.",IDC_STATIC,7,79,186,8
    LTEXT           "If you hold down Shift while clicking, you double the amount of zoom.",IDC_STATIC,7,91,222,8
    LTEXT           "You can right-click on any part of the image to zoom out 50% and recenter around that point.",IDC_STATIC,7,60,301,8
END

